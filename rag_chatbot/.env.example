# Copy to .env and replace every placeholder before deployment.
APP_ENV=development
HOST=127.0.0.1
PORT=5000
APP_ORIGIN=
FLASK_DEBUG=false

DB_HOST=localhost
DB_PORT=3306
DB_USER=chatbot_app
DB_PASSWORD=replace-with-a-dedicated-database-password
DB_NAME=chatbot_db
DB_QUERY_TIMEOUT_MS=15000
DB_POOL_SIZE=5
APP_THREADS=4
# Set to the exact number of trusted reverse-proxy hops. Keep 0 for direct/local use.
TRUST_PROXY_HOPS=0

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
MODEL_TIMEOUT_SECONDS=90
MODEL_MAX_CONCURRENT=1
MODEL_QUEUE_WAIT_SECONDS=3

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_MINS=480
